{
  "name": "dsh-shortcuts-prompt",
  "version": "1.0.0",
  "description": "快捷指令 — keeps a strip of saved prompts above the DeepSeek Harness composer: click a chip to insert it at the caret, and manage the list inline.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "prompts",
    "composer",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithtomge-alt/dsh-shortcuts-prompt.git"
  },
  "homepage": "https://github.com/smithtomge-alt/dsh-shortcuts-prompt#readme",
  "bugs": {
    "url": "https://github.com/smithtomge-alt/dsh-shortcuts-prompt/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
